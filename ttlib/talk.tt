[% talk = object;
   WRAPPER page.tt -%]
      <h1 class="display-4 fst-italic">[% talk.title %]</h1>
      <p>
        <span class="badge rounded-pill bg-primary"><a href="[% talk.talk_type.url_path %]">[% talk.talk_type.type %]</a></span>
      </p>
[%   IF talk.description -%]
      <h2>Description</h2>
      [% talk.description | html_para %]
[%   END -%]
      <h2>Presentations</h2>
      <ul>
[%   FOR p IN talk.presentations -%]
        <li><a href="[% p.event.url_path %]">[% p.event.name_year %]</a> - [% p.datetime %]</li>
[%   END # FOR -%]
      </ul>
[%   IF talk.extras OR talk.talk_links.count -%]
      <nav>
        <div class="nav nav-tabs" id="nav-tab" role="tablist">
[%     IF talk.get_google_docs_code OR talk.get_pdf_url -%]
          <button class="nav-link active" id="nav-slides-tab"
            data-bs-toggle="tab" data-bs-target="#nav-slides"
            type="button" role="tab" aria-controls="nav-slides"
            aria-selected="true">Slides</button>
[%     END # IF talk.get_google_docs_code -%]
[%     IF talk.get_youtube_code -%]
          <button class="nav-link[% IF ! (talk.get_google_docs_code OR talk.get_pdf_url) %] active[% END %]" id="nav-video-tab"
            data-bs-toggle="tab" data-bs-target="#nav-video"
            type="button" role="tab" aria-controls="nav-video"
            aria-selected="[% IF talk.get_google_docs_code OR talk.get_pdf_url %]false[% ELSE %]true[% END %]">Video</button>
[%     END # IF talk.get_youtube_code -%]
[%     IF talk.summary -%]
          <button class="nav-link" id="nav-summary-tab"
            data-bs-toggle="tab" data-bs-target="#nav-summary"
            type="button" role="tab" aria-controls="nav-summary"
            aria-selected="false">Summary</button>
[%     END # IF talk.summary -%]
[%     IF talk.talk_links.count -%]
          <button class="nav-link[% IF ! (talk.extras OR talk.summary) %] active[% END %]" id="nav-references-tab"
            data-bs-toggle="tab" data-bs-target="#nav-references"
            type="button" role="tab" aria-controls="nav-references"
            aria-selected="[% IF talk.extras OR talk.summary %]false[% ELSE %]true[% END %]">References</button>
[%     END # IF talk.talk_links.count -%]
        </div>
      </nav>
      <div class="tab-content" id="nav-tabContent">
[%     IF talk.get_google_docs_code -%]
        <div class="tab-pane fade show active" id="nav-slides"
          role="tabpanel" aria-labelledby="nav-slides-tab">
          <iframe class="extra" src="https://docs.google.com/presentation/d/e/[% talk.get_google_docs_code %]/embed?start=false&loop=false&delayms=3000"
            allowfullscreen></iframe>
        </div>
[%     ELSIF talk.get_pdf_url -%]
        <div class="tab-pane fade show active" id="nav-slides"
          role="tabpanel" aria-labelledby="nav-slides-tab">
          <iframe class="extra" src="[% talk.get_pdf_url %]#view=fitW" allowfullscreen></iframe>
        </div>
[%     END # IF talk.get_google_docs_code -%]
[%     IF talk.get_youtube_code -%]
        <div class="tab-pane fade[% IF ! (talk.get_google_docs_code OR talk.get_pdf_url) %] show active[% END %]" id="nav-video"
          role="tabpanel" aria-labelledby="nav-video-tab">
          <iframe class="extra"
            src="https://www.youtube.com/embed/[% talk.get_youtube_code %]"
            title="[% talk.title %]"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
[%     END # IF talk.get_youtube_code -%]
[%     IF talk.summary -%]
        <div class="tab-pane fade" id="nav-summary" role="tabpanel" aria-labelledby="nav-summary-tab">
          <small class="text-muted text-center">This summary has been generated using AI</small>
          <hr>
        [% talk.summary_html %]
        </div>
[%     END # talk.summary -%]
[%     IF talk.talk_links.count -%]
        <div class="tab-pane fade[% IF ! (talk.extras OR talk.summary) %] show active[% END %]" id="nav-references" role="tabpanel" aria-labelledby="nav-references-tab">
          <ul class="list-unstyled fs-5">
[%       FOR link IN talk.talk_links -%]
            <li>
              <a class="reference-link" href="[% link.link | html %]">
[%         IF link.type == 'article' -%]
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m13.5 2.5 1 1L6 12l-3 1 1-3 9.5-7.5z"/><path d="m11.5 4.5 1 1"/></svg>
[%         ELSIF link.type == 'website' -%]
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6.5"/><path d="M1.5 8h13M8 1.5c2 2 2 11 0 13m0-13c-2 2-2 11 0 13"/></svg>
[%         ELSIF link.type == 'code' -%]
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
[%         END -%]
                [% link.display_title | html %]</a>
            </li>
[%       END # FOR link -%]
          </ul>
        </div>
[%     END # IF talk.talk_links.count -%]
      </div>
[%   END # IF talk.extras -%]
[% END # WRAPPER -%]
